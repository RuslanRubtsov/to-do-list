# The public demo's settings (docs/deployment.md). Copy to .env on the server, which Git ignores,
# and replace the domain and the passwords. Not for local development: there, no .env is needed.

# Makes every `docker compose` command on the server use the production setup on top of the base one
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# The domain name pointing at the server; Caddy gets its HTTPS certificate for it
DOMAIN=your-name.duckdns.org

# Passwords for the database's application user and its root user. MySQL applies them only when it
# creates the database, on the first start: changing them later needs the database reset.
MYSQL_PASSWORD=change-me-to-a-long-random-password
MYSQL_ROOT_PASSWORD=change-me-to-another-long-random-password
